<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="CancelledAppointments" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" whenNoDataType="NoPages">

<parameter name="fromDate" class="java.sql.Date"/>
<parameter name="toDate" class="java.sql.Date"/>
<query language="SQL"><![CDATA[SELECT a.id AS appointmentId, a.appointment_date AS appointmentDate, c.name AS ownerName,
p.name AS petName, s.name AS serviceName, s.price AS servicePrice
FROM appointment a LEFT JOIN pet p ON a.pet_id=p.id LEFT JOIN customer c ON p.owner_id=c.id
LEFT JOIN service s ON a.service_id=s.id
WHERE a.appointment_date BETWEEN $P{fromDate} AND $P{toDate} AND a.status='Cancelled'
ORDER BY a.appointment_date,a.id]]></query>
<field name="appointmentId" class="java.lang.Integer"/>
<field name="appointmentDate" class="java.sql.Date"/>
<field name="ownerName" class="java.lang.String"/>
<field name="petName" class="java.lang.String"/>
<field name="serviceName" class="java.lang.String"/>
<field name="servicePrice" class="java.math.BigDecimal"/>
<title height="133"><element kind="rectangle" x="0" y="0" width="535" height="122" mode="Opaque" backcolor="#FFF8F0" forecolor="#FFF8F0"><pen lineWidth="0.0"/></element><element kind="rectangle" x="0" y="0" width="5" height="122" mode="Opaque" backcolor="#17787A" forecolor="#17787A"><pen lineWidth="0.0"/></element><element kind="staticText" x="18" y="8" width="499" height="32" fontName="SansSerif" fontSize="25" forecolor="#17787A" bold="true" vTextAlign="Middle"><text><![CDATA[PAWLISH]]></text></element><element kind="staticText" x="18" y="43" width="499" height="26" fontName="SansSerif" fontSize="18" forecolor="#23363D" bold="true" vTextAlign="Middle"><text><![CDATA[Cancelled Appointments]]></text></element><element kind="staticText" x="18" y="72" width="499" height="18" fontName="SansSerif" fontSize="9" forecolor="#23363D" bold="false" vTextAlign="Middle"><text><![CDATA[Cancelled bookings within the selected appointment dates]]></text></element><element kind="textField" x="18" y="94" width="499" height="18" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["PERIOD  " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{fromDate}) + "  to  " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{toDate})]]></expression></element></title><columnHeader height="32"><element kind="rectangle" x="0" y="0" width="535" height="30" mode="Opaque" backcolor="#17787A" forecolor="#17787A"><pen lineWidth="0.0"/></element><element kind="staticText" x="5" y="0" width="25" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[ID]]></text></element><element kind="staticText" x="40" y="0" width="56" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Date]]></text></element><element kind="staticText" x="106" y="0" width="110" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Owner]]></text></element><element kind="staticText" x="226" y="0" width="62" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Pet]]></text></element><element kind="staticText" x="298" y="0" width="150" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Service]]></text></element><element kind="staticText" x="458" y="0" width="72" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Price (Rs.)]]></text></element></columnHeader><detail><band height="34" splitType="Stretch"><element kind="rectangle" x="0" y="0" width="535" height="34" mode="Opaque" backcolor="#F1F7F6" forecolor="#F1F7F6" stretchType="ContainerHeight"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression><pen lineWidth="0.0"/></element><element kind="textField" x="5" y="3" width="25" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA[$F{appointmentId}]]></expression></element><element kind="textField" x="40" y="3" width="56" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight" pattern="dd/MM/yyyy"><expression><![CDATA[$F{appointmentDate}]]></expression></element><element kind="textField" x="106" y="3" width="110" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{ownerName}]]></expression></element><element kind="textField" x="226" y="3" width="62" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{petName}]]></expression></element><element kind="textField" x="298" y="3" width="150" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{serviceName}]]></expression></element><element kind="textField" x="458" y="3" width="72" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight" pattern="#,##0.00"><expression><![CDATA[$F{servicePrice}]]></expression></element></band></detail><pageFooter height="28"><element kind="rectangle" x="0" y="0" width="535" height="1" mode="Opaque" backcolor="#BFD3D0" forecolor="#BFD3D0"><pen lineWidth="0.0"/></element><element kind="textField" x="0" y="7" width="460" height="16" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["Pawlish  |  Generated " + new java.text.SimpleDateFormat("dd MMM yyyy").format(new java.util.Date())]]></expression></element><element kind="textField" x="465" y="7" width="70" height="16" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element></pageFooter><summary height="94"><element kind="rectangle" x="0" y="12" width="535" height="44" mode="Opaque" backcolor="#E3F4F1" forecolor="#E3F4F1"><pen lineWidth="0.0"/></element><element kind="rectangle" x="0" y="12" width="4" height="44" mode="Opaque" backcolor="#FF8A65" forecolor="#FF8A65"><pen lineWidth="0.0"/></element><element kind="textField" x="14" y="22" width="507" height="24" fontName="SansSerif" fontSize="10" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["CANCELLED APPOINTMENTS   " + $V{REPORT_COUNT}]]></expression></element><element kind="staticText" x="0" y="64" width="535" height="20" fontName="SansSerif" fontSize="8" forecolor="#23363D" bold="false" vTextAlign="Middle"><text><![CDATA[Prices are current listed service prices, not confirmed lost revenue.]]></text></element></summary></jasperReport>