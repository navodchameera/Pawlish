<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="AppointmentDetails" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" whenNoDataType="NoPages">

<parameter name="fromDate" class="java.sql.Date"/>
<parameter name="toDate" class="java.sql.Date"/>
<query language="SQL"><![CDATA[SELECT a.id AS appointmentId, a.appointment_date AS appointmentDate, a.appointment_time AS appointmentTime,
c.name AS customerName, c.phone AS customerPhone, p.name AS petName, p.species AS species, p.breed AS breed,
s.name AS serviceName, CONCAT_WS(' ', u.firstName, u.lastName) AS groomerName, a.status AS status
FROM appointment a LEFT JOIN pet p ON a.pet_id=p.id LEFT JOIN customer c ON p.owner_id=c.id
LEFT JOIN service s ON a.service_id=s.id LEFT JOIN `user` u ON a.groomer_id=u.id
WHERE a.appointment_date BETWEEN $P{fromDate} AND $P{toDate}
ORDER BY a.appointment_date,a.appointment_time,a.id]]></query>
<field name="appointmentId" class="java.lang.Integer"/>
<field name="appointmentDate" class="java.sql.Date"/>
<field name="appointmentTime" class="java.sql.Time"/>
<field name="customerName" class="java.lang.String"/>
<field name="customerPhone" class="java.lang.String"/>
<field name="petName" class="java.lang.String"/>
<field name="species" class="java.lang.String"/>
<field name="breed" class="java.lang.String"/>
<field name="serviceName" class="java.lang.String"/>
<field name="groomerName" class="java.lang.String"/>
<field name="status" class="java.lang.String"/>
<variable name="completedTotal" class="java.lang.Integer" calculation="Sum"><expression><![CDATA["Done".equals($F{status}) ? 1 : 0]]></expression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable><variable name="cancelledTotal" class="java.lang.Integer" calculation="Sum"><expression><![CDATA["Cancelled".equals($F{status}) ? 1 : 0]]></expression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable><title height="133"><element kind="rectangle" x="0" y="0" width="802" height="122" mode="Opaque" backcolor="#FFF8F0" forecolor="#FFF8F0"><pen lineWidth="0.0"/></element><element kind="rectangle" x="0" y="0" width="5" height="122" mode="Opaque" backcolor="#17787A" forecolor="#17787A"><pen lineWidth="0.0"/></element><element kind="staticText" x="18" y="8" width="766" height="32" fontName="SansSerif" fontSize="25" forecolor="#17787A" bold="true" vTextAlign="Middle"><text><![CDATA[PAWLISH]]></text></element><element kind="staticText" x="18" y="43" width="766" height="26" fontName="SansSerif" fontSize="18" forecolor="#23363D" bold="true" vTextAlign="Middle"><text><![CDATA[Appointment Details]]></text></element><element kind="staticText" x="18" y="72" width="766" height="18" fontName="SansSerif" fontSize="9" forecolor="#23363D" bold="false" vTextAlign="Middle"><text><![CDATA[Booking details, customers, pets and assigned groomers]]></text></element><element kind="textField" x="18" y="94" width="766" height="18" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["PERIOD  " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{fromDate}) + "  to  " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{toDate})]]></expression></element></title><columnHeader height="32"><element kind="rectangle" x="0" y="0" width="802" height="30" mode="Opaque" backcolor="#17787A" forecolor="#17787A"><pen lineWidth="0.0"/></element><element kind="staticText" x="5" y="0" width="22" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[ID]]></text></element><element kind="staticText" x="37" y="0" width="50" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Date]]></text></element><element kind="staticText" x="97" y="0" width="40" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Time]]></text></element><element kind="staticText" x="147" y="0" width="95" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Customer]]></text></element><element kind="staticText" x="252" y="0" width="63" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Phone]]></text></element><element kind="staticText" x="325" y="0" width="63" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Pet]]></text></element><element kind="staticText" x="398" y="0" width="39" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Species]]></text></element><element kind="staticText" x="447" y="0" width="70" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Breed]]></text></element><element kind="staticText" x="527" y="0" width="101" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Service]]></text></element><element kind="staticText" x="638" y="0" width="89" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Groomer]]></text></element><element kind="staticText" x="737" y="0" width="60" height="30" fontName="SansSerif" fontSize="8" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Status]]></text></element></columnHeader><detail><band height="34" splitType="Stretch"><element kind="rectangle" x="0" y="0" width="802" height="34" mode="Opaque" backcolor="#F1F7F6" forecolor="#F1F7F6" stretchType="ContainerHeight"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression><pen lineWidth="0.0"/></element><element kind="textField" x="5" y="3" width="22" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA[$F{appointmentId}]]></expression></element><element kind="textField" x="37" y="3" width="50" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight" pattern="dd/MM/yyyy"><expression><![CDATA[$F{appointmentDate}]]></expression></element><element kind="textField" x="97" y="3" width="40" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight" pattern="hh:mm a"><expression><![CDATA[$F{appointmentTime}]]></expression></element><element kind="textField" x="147" y="3" width="95" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{customerName}]]></expression></element><element kind="textField" x="252" y="3" width="63" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{customerPhone}]]></expression></element><element kind="textField" x="325" y="3" width="63" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{petName}]]></expression></element><element kind="textField" x="398" y="3" width="39" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{species}]]></expression></element><element kind="textField" x="447" y="3" width="70" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{breed}]]></expression></element><element kind="textField" x="527" y="3" width="101" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{serviceName}]]></expression></element><element kind="textField" x="638" y="3" width="89" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{groomerName}]]></expression></element><element kind="textField" x="737" y="3" width="60" height="28" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{status}]]></expression></element></band></detail><pageFooter height="28"><element kind="rectangle" x="0" y="0" width="802" height="1" mode="Opaque" backcolor="#BFD3D0" forecolor="#BFD3D0"><pen lineWidth="0.0"/></element><element kind="textField" x="0" y="7" width="727" height="16" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["Pawlish  |  Generated " + new java.text.SimpleDateFormat("dd MMM yyyy").format(new java.util.Date())]]></expression></element><element kind="textField" x="732" y="7" width="70" height="16" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element></pageFooter><summary height="94"><element kind="rectangle" x="0" y="12" width="802" height="44" mode="Opaque" backcolor="#E3F4F1" forecolor="#E3F4F1"><pen lineWidth="0.0"/></element><element kind="rectangle" x="0" y="12" width="4" height="44" mode="Opaque" backcolor="#FF8A65" forecolor="#FF8A65"><pen lineWidth="0.0"/></element><element kind="textField" x="14" y="22" width="774" height="24" fontName="SansSerif" fontSize="10" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["APPOINTMENTS   " + $V{REPORT_COUNT} + "       COMPLETED   " + $V{completedTotal} + "       CANCELLED   " + $V{cancelledTotal}]]></expression></element><element kind="staticText" x="0" y="64" width="802" height="20" fontName="SansSerif" fontSize="8" forecolor="#23363D" bold="false" vTextAlign="Middle"><text><![CDATA[Dates refer to scheduled appointments. All appointment statuses are included.]]></text></element></summary></jasperReport>