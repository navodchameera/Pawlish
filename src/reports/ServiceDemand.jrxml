<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ServiceDemand" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" whenNoDataType="NoPages">

<parameter name="fromDate" class="java.sql.Date"/>
<parameter name="toDate" class="java.sql.Date"/>
<query language="SQL"><![CDATA[SELECT s.name AS serviceName, p.species AS species, COUNT(a.id) AS totalBookings,
SUM(CASE WHEN a.status='Done' THEN 1 ELSE 0 END) AS completedCount,
SUM(CASE WHEN a.status='Cancelled' THEN 1 ELSE 0 END) AS cancelledCount,
ROUND(100.0*SUM(CASE WHEN a.status='Cancelled' THEN 1 ELSE 0 END)/COUNT(a.id),2) AS cancellationRate
FROM appointment a JOIN service s ON a.service_id=s.id JOIN pet p ON a.pet_id=p.id
WHERE a.appointment_date BETWEEN $P{fromDate} AND $P{toDate}
GROUP BY s.id,s.name,p.species ORDER BY totalBookings DESC,s.name,p.species]]></query>
<field name="serviceName" class="java.lang.String"/>
<field name="species" class="java.lang.String"/>
<field name="totalBookings" class="java.lang.Long"/>
<field name="completedCount" class="java.math.BigDecimal"/>
<field name="cancelledCount" class="java.math.BigDecimal"/>
<field name="cancellationRate" class="java.math.BigDecimal"/>
<variable name="bookingsTotal" class="java.lang.Long" calculation="Sum"><expression><![CDATA[$F{totalBookings}.longValue()]]></expression><initialValueExpression><![CDATA[0L]]></initialValueExpression></variable><variable name="completedTotal" class="java.lang.Long" calculation="Sum"><expression><![CDATA[$F{completedCount}.longValue()]]></expression><initialValueExpression><![CDATA[0L]]></initialValueExpression></variable><variable name="cancelledTotal" class="java.lang.Long" calculation="Sum"><expression><![CDATA[$F{cancelledCount}.longValue()]]></expression><initialValueExpression><![CDATA[0L]]></initialValueExpression></variable><title height="133"><element kind="rectangle" x="0" y="0" width="535" height="122" mode="Opaque" backcolor="#FFF8F0" forecolor="#FFF8F0"><pen lineWidth="0.0"/></element><element kind="rectangle" x="0" y="0" width="5" height="122" mode="Opaque" backcolor="#17787A" forecolor="#17787A"><pen lineWidth="0.0"/></element><element kind="staticText" x="18" y="8" width="499" height="32" fontName="SansSerif" fontSize="25" forecolor="#17787A" bold="true" vTextAlign="Middle"><text><![CDATA[PAWLISH]]></text></element><element kind="staticText" x="18" y="43" width="499" height="26" fontName="SansSerif" fontSize="18" forecolor="#23363D" bold="true" vTextAlign="Middle"><text><![CDATA[Service Demand by Pet Species]]></text></element><element kind="staticText" x="18" y="72" width="499" height="18" fontName="SansSerif" fontSize="9" forecolor="#23363D" bold="false" vTextAlign="Middle"><text><![CDATA[Booking demand and cancellations by service and species]]></text></element><element kind="textField" x="18" y="94" width="499" height="18" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["PERIOD  " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{fromDate}) + "  to  " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{toDate})]]></expression></element></title><columnHeader height="32"><element kind="rectangle" x="0" y="0" width="535" height="30" mode="Opaque" backcolor="#17787A" forecolor="#17787A"><pen lineWidth="0.0"/></element><element kind="staticText" x="5" y="0" width="150" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Service]]></text></element><element kind="staticText" x="165" y="0" width="60" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Species]]></text></element><element kind="staticText" x="235" y="0" width="58" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Bookings]]></text></element><element kind="staticText" x="303" y="0" width="68" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Completed]]></text></element><element kind="staticText" x="381" y="0" width="64" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Cancelled]]></text></element><element kind="staticText" x="455" y="0" width="75" height="30" fontName="SansSerif" fontSize="9" forecolor="#FFFFFF" bold="true" vTextAlign="Middle"><text><![CDATA[Cancelled %]]></text></element></columnHeader><detail><band height="34" splitType="Stretch"><element kind="rectangle" x="0" y="0" width="535" height="34" mode="Opaque" backcolor="#F1F7F6" forecolor="#F1F7F6" stretchType="ContainerHeight"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression><pen lineWidth="0.0"/></element><element kind="textField" x="5" y="3" width="150" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{serviceName}]]></expression></element><element kind="textField" x="165" y="3" width="60" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA[$F{species}]]></expression></element><element kind="textField" x="235" y="3" width="58" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA[$F{totalBookings}]]></expression></element><element kind="textField" x="303" y="3" width="68" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA[$F{completedCount}]]></expression></element><element kind="textField" x="381" y="3" width="64" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA[$F{cancelledCount}]]></expression></element><element kind="textField" x="455" y="3" width="75" height="28" fontName="SansSerif" fontSize="9" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight" pattern="0.00"><expression><![CDATA[$F{cancellationRate}]]></expression></element></band></detail><pageFooter height="28"><element kind="rectangle" x="0" y="0" width="535" height="1" mode="Opaque" backcolor="#BFD3D0" forecolor="#BFD3D0"><pen lineWidth="0.0"/></element><element kind="textField" x="0" y="7" width="460" height="16" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["Pawlish  |  Generated " + new java.text.SimpleDateFormat("dd MMM yyyy").format(new java.util.Date())]]></expression></element><element kind="textField" x="465" y="7" width="70" height="16" fontName="SansSerif" fontSize="8" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Right" textAdjust="StretchHeight"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element></pageFooter><summary height="94"><element kind="rectangle" x="0" y="12" width="535" height="44" mode="Opaque" backcolor="#E3F4F1" forecolor="#E3F4F1"><pen lineWidth="0.0"/></element><element kind="rectangle" x="0" y="12" width="4" height="44" mode="Opaque" backcolor="#FF8A65" forecolor="#FF8A65"><pen lineWidth="0.0"/></element><element kind="textField" x="14" y="22" width="507" height="24" fontName="SansSerif" fontSize="10" forecolor="#23363D" blankWhenNull="true" vTextAlign="Middle" hTextAlign="Left" textAdjust="StretchHeight"><expression><![CDATA["BOOKINGS   " + $V{bookingsTotal} + "     COMPLETED   " + $V{completedTotal} + "     CANCELLED   " + $V{cancelledTotal}]]></expression></element><element kind="staticText" x="0" y="64" width="535" height="20" fontName="SansSerif" fontSize="8" forecolor="#23363D" bold="false" vTextAlign="Middle"><text><![CDATA[Cancellation rate = cancelled bookings / total bookings x 100.]]></text></element></summary></jasperReport>